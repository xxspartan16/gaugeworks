{
  "name": "gaugeworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Understand process drift before a bad batch.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
